# Copie para .env (cp .env.example .env) e preencha. O .env não vai para o Git.

# Formato provedor:modelo, por exemplo openai:<modelo>, google_genai:<modelo>, anthropic:<modelo>
LUPA_MODELO=openai:nome-do-modelo

# Chave do provedor; o nome da variável muda conforme o provedor
# (OPENAI_API_KEY, GOOGLE_API_KEY, ANTHROPIC_API_KEY...)
OPENAI_API_KEY=
