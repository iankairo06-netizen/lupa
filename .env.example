# Copie para .env (cp .env.example .env) e preencha. O .env não vai para o Git.

# Formato provedor:modelo. Para o vLLM, o provedor é openai (a API do vLLM é
# compatível com a da OpenAI) e o modelo é o "id" listado em <LUPA_BASE_URL>/models.
LUPA_MODELO=openai:nome-do-modelo-no-vllm

# Endereço do servidor vLLM, terminando em /v1. Vazio usa a API oficial do provedor.
LUPA_BASE_URL=http://endereco-da-workstation:8000/v1

# Só se o vLLM foi iniciado com --api-key. Pode ficar vazio.
LUPA_API_KEY=
