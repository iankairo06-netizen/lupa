# Modelo de configuração. Copie para .env e preencha:
#     cp .env.example .env
# O .env está no .gitignore e nunca vai para o Git. Este arquivo vai,
# porque não tem nenhum segredo: só mostra quais variáveis existem.

# Modelo no formato provedor:modelo. O nome exato do modelo o time informa.
# Exemplos de provedores: openai, google_genai, anthropic, azure_openai
LUPA_MODELO=openai:nome-do-modelo

# Chave da API. O nome da variável depende do provedor, por exemplo:
# OPENAI_API_KEY, GOOGLE_API_KEY, ANTHROPIC_API_KEY
OPENAI_API_KEY=
